# Leave DATABASE_URL unset to use local SQLite (study_planner.db).
# For hosted mode, use the PostgreSQL connection URL from your hosting provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate a private random value for each hosted deployment, for example:
# python -c "import secrets; print(secrets.token_hex(32))"
UNINEST_SECRET_KEY=replace-with-a-long-random-secret
UNINEST_SECURE_COOKIES=1
